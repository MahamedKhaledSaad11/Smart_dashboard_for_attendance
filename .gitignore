# ==========================================
# UniAttend AI - .gitignore
# ==========================================

# 1. Local / Runtime Generated Folders
AppData/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 2. Generated Test & Export Reports in Root
test_arabic.pdf
Attendance_Executive_Summary.pdf
Attendance_Matrix_Report.xlsx

# Temporary Excel lock files
~$*.xlsx
~$*.xls

# 3. Sensitive & Environment Secrets
.env
.env.*
*.env
*.pem
*.key
credentials.json
secrets.json
.streamlit/secrets.toml

# 4. Virtual Environments & Packaging
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg

# 5. Vercel & Node / Deployment Artifacts
.vercel/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# 7. Operating System Artifacts
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Keep sample_data directory tracked for demo functionality
!sample_data/
!sample_data/*.xlsx
